# Public address. Point this hostname to the VPS before starting Caddy.
APP_DOMAIN=comment.example.com
PUBLIC_BASE_URL=https://comment.example.com

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Generate unique values with: npm run generate:env -- your.domain.example
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-token

META_MODE=live
META_GRAPH_VERSION=v25.0
QUEUE_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=5

POSTGRES_DB=commentdm
POSTGRES_USER=commentdm
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgres://commentdm:replace-with-a-random-database-password@db:5432/commentdm
